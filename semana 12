class Libro:
    def __init__(self, isbn, titulo, autor, categoria):
        self.isbn = isbn
        self.titulo = titulo
        self.autor = autor
        self.categoria = categoria

    def __repr__(self):
        return f"Libro(ISBN: {self.isbn}, Titulo: {self.titulo}, Autor: {self.autor}, Categoria: {self.categoria})"

class Usuario:
    def __init__(self, id_usuario, nombre):
        self.id_usuario = id_usuario
        self.nombre = nombre
        self.libros_prestados = []

    def prestar_libro(self, libro):
        self.libros_prestados.append(libro)
        print(f"{self.nombre} ha prestado el libro: {libro.titulo}")

    def devolver_libro(self, libro):
        if libro in self.libros_prestados:
            self.libros_prestados.remove(libro)
            print(f"{self.nombre} ha devuelto el libro: {libro.titulo}")
        else:
            print(f"{self.nombre} no tiene el libro: {libro.titulo}")

    def listar_libros_prestados(self):
        return self.libros_prestados

    def __repr__(self):
        return f"Usuario(ID: {self.id_usuario}, Nombre: {self.nombre}, Libros Prestados: {self.libros_prestados})"

class Biblioteca:
    def __init__(self):
        self.libros = {}  # Diccionario para almacenar libros por ISBN
        self.usuarios = {}  # Diccionario para almacenar usuarios por ID

    def añadir_libro(self, libro):
        if libro.isbn not in self.libros:
            self.libros[libro.isbn] = libro
            print(f"Libro añadido: {libro}")
        else:
            print(f"El libro con ISBN {libro.isbn} ya existe en la biblioteca.")

    def quitar_libro(self, isbn):
        if isbn in self.libros:
            libro = self.libros.pop(isbn)
            print(f"Libro eliminado: {libro}")
        else:
            print(f"No se encontró un libro con ISBN {isbn} en la biblioteca.")

    def registrar_usuario(self, usuario):
        if usuario.id_usuario not in self.usuarios:
            self.usuarios[usuario.id_usuario] = usuario
            print(f"Usuario registrado: {usuario}")
        else:
            print(f"El usuario con ID {usuario.id_usuario} ya está registrado en la biblioteca.")

    def dar_de_baja_usuario(self, id_usuario):
        if id_usuario in self.usuarios:
            usuario = self.usuarios.pop(id_usuario)
            print(f"Usuario dado de baja: {usuario}")
        else:
            print(f"No se encontró un usuario con ID {id_usuario} en la biblioteca.")

    def prestar_libro(self, id_usuario, isbn):
        usuario = self.usuarios.get(id_usuario)
        libro = self.libros.get(isbn)
        if usuario and libro:
            usuario.prestar_libro(libro)
        elif not usuario:
            print(f"No se encontró un usuario con ID {id_usuario}")
        elif not libro:
            print(f"No se encontró un libro con ISBN {isbn}")

    def devolver_libro(self, id_usuario, isbn):
        usuario = self.usuarios.get(id_usuario)
        libro = self.libros.get(isbn)
        if usuario and libro:
            usuario.devolver_libro(libro)
        elif not usuario:
            print(f"No se encontró un usuario con ID {id_usuario}")
        elif not libro:
            print(f"No se encontró un libro con ISBN {isbn}")

    def buscar_libros(self, criterio, valor):
        resultados = []
        for libro in self.libros.values():
            if (criterio == "titulo" and libro.titulo.lower() == valor.lower()) or \
                    (criterio == "autor" and libro.autor.lower() == valor.lower()) or \
                    (criterio == "categoria" and libro.categoria.lower() == valor.lower()):
                resultados.append(libro)
        return resultados

    def listar_libros_prestados_por_usuario(self, id_usuario):
        usuario = self.usuarios.get(id_usuario)
        if usuario:
            return usuario.listar_libros_prestados()
        else:
            print(f"No se encontró un usuario con ID {id_usuario}")
            return []

# Pruebas del sistema
biblioteca = Biblioteca()

# Añadir libros
libro1 = Libro("978-3-16-148410-0", "El Gran Gatsby", "F. Scott Fitzgerald", "Novela")
libro2 = Libro("978-0-14-143951-8", "1984", "George Orwell", "Distopia")
biblioteca.añadir_libro(libro1)
biblioteca.añadir_libro(libro2)

# Registrar usuarios
usuario1 = Usuario(1, "Alice")
usuario2 = Usuario(2, "Bob")
biblioteca.registrar_usuario(usuario1)
biblioteca.registrar_usuario(usuario2)

# Prestar libros
biblioteca.prestar_libro(1, "978-3-16-148410-0")
biblioteca.prestar_libro(2, "978-0-14-143951-8")

# Listar libros prestados por usuario
print("Libros prestados a Alice:", biblioteca.listar_libros_prestados_por_usuario(1))
print("Libros prestados a Bob:", biblioteca.listar_libros_prestados_por_usuario(2))

# Devolver libro
biblioteca.devolver_libro(1, "978-3-16-148410-0")

# Buscar libros
resultados_busqueda = biblioteca.buscar_libros("autor", "George Orwell")
print("Resultados de búsqueda por autor:", resultados_busqueda)

# Quitar un libro
biblioteca.quitar_libro("978-3-16-148410-0")

# Dar de baja a un usuario
biblioteca.dar_de_baja_usuario(2)
