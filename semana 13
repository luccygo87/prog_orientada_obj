import tkinter as tk
from tkinter import messagebox
from tkinter.ttk import Treeview

def agregar_info():
    dato = entrada.get()
    if dato:
        lista.insert("", tk.END, values=(dato,))
        entrada.delete(0, tk.END)
    else:
        messagebox.showwarning("Advertencia", "Por favor, ingrese un dato.")

def limpiar_seleccion():
    seleccion = lista.selection()
    if seleccion:
        lista.delete(seleccion)
    else:
        messagebox.showwarning("Advertencia", "Por favor, seleccione un elemento para eliminar.")

def limpiar_todo():
    lista.delete(*lista.get_children())

ventana = tk.Tk()
ventana.title("Gestor de Datos")
ventana.geometry("400x300")

etiqueta = tk.Label(ventana, text="Ingrese un dato:")
etiqueta.pack(pady=5)

entrada = tk.Entry(ventana, width=40)
entrada.pack(pady=5)

boton_agregar = tk.Button(ventana, text="Agregar", command=agregar_info)
boton_agregar.pack(side=tk.LEFT, padx=10, pady=10)

boton_limpiar_seleccion = tk.Button(ventana, text="Limpiar Selección", command=limpiar_seleccion)
boton_limpiar_seleccion.pack(side=tk.LEFT, padx=10, pady=10)

boton_limpiar_todo = tk.Button(ventana, text="Limpiar Todo", command=limpiar_todo)
boton_limpiar_todo.pack(side=tk.LEFT, padx=10, pady=10)

lista = Treeview(ventana, columns=("Dato",), show="headings", height=10)
lista.heading("Dato", text="Dato")
lista.pack(pady=10, fill=tk.BOTH, expand=True)

ventana.mainloop()
